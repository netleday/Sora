{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sora-v2.0-Setup",
  "version": "2.0.0",
  "identifier": "dev.sora.setup",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Установка Sora v2.0",
        "width": 780,
        "height": 450,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
